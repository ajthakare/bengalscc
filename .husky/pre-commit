#!/usr/bin/env sh

echo "Running pre-commit security checks..."

# Check if any local-debug/ files are staged
if git diff --cached --name-only | grep -q "^local-debug/"; then
  echo "❌ ERROR: local-debug/ files cannot be committed!"
  echo "These files contain debug/migration scripts that bypass security."
  echo ""
  echo "To fix: git reset HEAD local-debug/"
  exit 1
fi

# Check if .env is staged
if git diff --cached --name-only | grep -q "^\.env$"; then
  echo "❌ ERROR: .env file cannot be committed!"
  echo "This file contains sensitive credentials."
  echo ""
  echo "To fix: git reset HEAD .env"
  exit 1
fi

# Check if debug functions accidentally copied to netlify/functions/
DEBUG_FUNCTIONS=$(git diff --cached --name-only | grep "^netlify/functions/" | grep -E "(check-|fix-|migrate-|debug-)")
if [ -n "$DEBUG_FUNCTIONS" ]; then
  echo "❌ ERROR: Debug functions found in netlify/functions/:"
  echo "$DEBUG_FUNCTIONS"
  echo ""
  echo "These must be in local-debug/ folder only."
  echo "To fix: git reset HEAD netlify/functions/<file>"
  exit 1
fi

echo "✓ Security checks passed"
exit 0
