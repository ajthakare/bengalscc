---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { validateAdminSession } from '../middleware/auth';

// Redirect to home if already logged in
const cookieHeader = Astro.request.headers.get('cookie');
const session = validateAdminSession(cookieHeader || '');
if (session) {
  return Astro.redirect('/');
}
---

<Layout title="Forgot Password - Golden State Cricket Club">
  <div class="auth-page-wrapper min-h-screen flex items-start justify-center px-4 pb-6 pt-8">
    <div class="max-w-md w-full space-y-8">

      <!-- PWA: Logo shown only in standalone mode -->
      <div class="pwa-auth-logo">
        <img src="/icons/icon-192.png" alt="GSCC" width="72" height="72" />
      </div>

      <div class="text-center">
        <h1 class="text-3xl font-bold text-[#355c7d] mb-2">Forgot Password?</h1>
        <p class="text-gray-600">Enter your email and we'll send reset instructions</p>
      </div>

      <!-- Request Form -->
      <div id="request-form-section" class="bg-white rounded-lg shadow-lg p-8">
        <div id="error-message" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700"></div>

        <form id="forgot-form" class="space-y-5">
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              Email Address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#f67280] focus:border-transparent"
              placeholder="Enter your email"
            />
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 px-4 rounded-lg font-semibold text-white transition-colors"
            style="background-color: #f67280;"
          >
            Send Reset Request
          </button>
        </form>
      </div>

      <!-- Success State -->
      <div id="success-section" class="hidden bg-white rounded-lg shadow-lg p-8 text-center">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h2 class="text-xl font-bold text-gray-900 mb-2">Request Submitted</h2>
        <p class="text-gray-600 text-sm mb-6">
          Your password reset request has been submitted. An admin will review it and contact you shortly.
        </p>
        <a href="/login" class="inline-block py-2 px-6 rounded-lg font-semibold text-white" style="background-color: #f67280;">
          Back to Login
        </a>
      </div>

      <div class="text-center text-sm text-gray-600 space-y-2">
        <div>
          Remember your password?
          <a href="/login" class="text-[#f67280] font-semibold hover:underline">Login</a>
        </div>
        <div class="browser-only-link">
          <a href="/" class="hover:text-[#f67280] transition-colors">&larr; Back to Website</a>
        </div>
      </div>

    </div>
  </div>

  <script>
    const form = document.getElementById('forgot-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const errorMessage = document.getElementById('error-message') as HTMLElement;
    const requestSection = document.getElementById('request-form-section') as HTMLElement;
    const successSection = document.getElementById('success-section') as HTMLElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      if (!email) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
      errorMessage.classList.add('hidden');

      try {
        const response = await fetch('/.netlify/functions/password-reset-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        // Always show success to not reveal if email exists
        requestSection.classList.add('hidden');
        successSection.classList.remove('hidden');
      } catch (error) {
        errorMessage.textContent = 'Something went wrong. Please try again.';
        errorMessage.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Reset Request';
      }
    });
  </script>

  <style>
    .pwa-auth-logo {
      display: none;
    }

    @media (display-mode: standalone) {
      .auth-page-wrapper {
        min-height: 100%;
        align-items: center;
        padding-top: 2rem;
        padding-bottom: 2rem;
      }

      .pwa-auth-logo {
        display: flex;
        justify-content: center;
        margin-bottom: -0.5rem;
      }

      .pwa-auth-logo img {
        border-radius: 20px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
      }

      .browser-only-link {
        display: none;
      }
    }
  </style>
</Layout>
