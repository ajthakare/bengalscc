---
export const prerender = false;

// Clear session cookie using Astro's cookie API
Astro.cookies.delete('bengals_admin_session', {
  path: '/'
});

// Redirect to login if ?from=pwa, otherwise home page
const from = Astro.url.searchParams.get('from');
return Astro.redirect(from === 'pwa' ? '/login' : '/');
---
